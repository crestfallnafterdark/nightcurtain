{
  "denyPaths": [
    "data/**",
    "scratch/**",
    "sandbox_world/**",
    "logs/**",
    "test-results/**",
    "playwright-report/**",
    ".playwright/**",
    "coverage/**",
    "**/.opencode/**",
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/*.log",
    "**/api-key",
    "**/.aider*"
  ],
  "binaryAllowGlobs": [
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.otf",
    "**/*.eot",
    "**/*.mp3",
    "**/*.wav",
    "**/*.mp4",
    "**/*.webm"
  ],
  "maxBytes": 1048576,
  "allowlist": [
    { "pattern": "tests/audit/repros/**", "rule": "credential-pattern", "reason": "synthetic credential fixtures in audit repros" },
    { "pattern": "tests/integration/modern_settings_workflow_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/integration/settings_modal_modern_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/unit/deepseek_provider_test.js", "rule": "credential-pattern", "reason": "synthetic invalid-key fixture" },
    { "pattern": "tests/unit/nanogpt_provider_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/unit/preset_catalog_module_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/unit/realm_registry_module_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/unit/runware_provider_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/unit/sandbox_persistence_module_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/unit/sandbox_store_module_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" },
    { "pattern": "tests/unit/settings_modal_presets_test.js", "rule": "credential-pattern", "reason": "synthetic credential fixtures in tests" }
  ]
}
