{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.81",
          "--headless",
          "--user-data-dir",
          ".playwright/qa-profile",
          "--viewport-size",
          "1440x900",
          "--output-dir",
          "test-results/qa",
          "--save-session",
          "--secrets",
          ".env.local"
        ],
        "disabled": false
      }
    }
  },
  "websearch": false
}
